# sentientd Configuration Example
# Copy this to .env and adjust values as needed

# Database Configuration
DATABASE_URL=postgres://sentientd:sentientd@localhost:5432/sentientd?sslmode=disable
# Set to true to use in-memory store instead of Postgres (for testing)
USE_INMEMORY_STORE=false

# Server Configuration
SENTIENTD_LISTEN_ADDR=:8080
SENTIENTD_SERVICE_NAME=sentientd
SENTIENTD_ENVIRONMENT=dev

# Correlation Configuration
SENTIENTD_INITIAL_WINDOW=30s
SENTIENTD_EXPANSION_WINDOW=5m

# Integration URLs
SENTIENTD_KAGENT_URL=http://localhost:8081
SENTIENTD_ARGO_NAMESPACE=argo
SENTIENTD_SLACK_WEBHOOK_URL=
